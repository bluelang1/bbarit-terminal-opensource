# Frontend endpoint overrides (Vite build-time, see src/config/endpoints.ts).
# Copy to .env or .env.local; unset keys fall back to the defaults shown here.

# API origin (Thread, notices, lounge and install script derive from it).
VITE_BBARIT_API_BASE_URL=https://bbarit.com

# Product notice feed. Set to "off" (or leave empty) to skip the fetch entirely.
VITE_BBARIT_NOTICES_URL=https://bbarit.com/api/products/notices

# Lounge websocket (https base -> wss). ~/.config/octo/.env BBARIT_LOUNGE_URL overrides at runtime.
VITE_BBARIT_LOUNGE_WS_URL=wss://bbarit.com/api/lounge/ws

# Install script shown when the bbarit-oss agent binary is missing.
VITE_BBARIT_AGENT_INSTALL_URL=https://bbarit.com/agent/install.sh

# GitHub owner/repo for the toolbar link and "open release page" fallback (macOS / Windows).
VITE_BBARIT_RELEASE_REPO_MAC=bluelang1/bbarit-terminal-opensource
VITE_BBARIT_RELEASE_REPO_WIN=bluelang1/bbarit-terminal-opensource
