{
  "name": "octo-ui",
  "private": true,
  "version": "1.1.54",
  "type": "module",
  "scripts": {
    "dev": "node scripts/vite-dev.mjs",
    "dev:check": "node scripts/vite-dev.mjs --check",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "smoke": "npm run app:bootstrap-smoke && npm run dev:screen:status && npm run browser:smoke",
    "verify": "npm run lint && npm run test:run && npm run ui:mojibake && npm run build && npm run smoke",
    "platform:verify": "node scripts/platform-full-verify.mjs",
    "mac:verify": "node scripts/platform-full-verify.mjs --require-platform darwin --report .octo-tmp/mac-full-verify.json",
    "win:verify": "node scripts/platform-full-verify.mjs --require-platform win32 --report .octo-tmp/win-full-verify.json",
    "win:prereq": "node scripts/windows-msvc-prereq.mjs --require-platform win32 --report .octo-tmp/win-prereq.json",
    "win:install-prereq": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-arm64-msvc-prereq.ps1",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-opensource.mjs",
    "tauri:dev": "node scripts/tauri-opensource.mjs dev",
    "tauri:build": "node scripts/tauri-opensource.mjs build",
    "tauri:build:fork": "node scripts/tauri-opensource.mjs build --fork-release",
    "release:fork:manifest": "node scripts/fork-release-manifest.mjs",
    "browser-agent:verify": "node scripts/browser-agent-verify.mjs",
    "browser-agent:report-check": "node scripts/browser-agent-report-check.mjs",
    "browser-agent:report-check:self-test": "node scripts/browser-agent-report-check-selftest.mjs",
    "browser-agent:compare-reports": "node scripts/browser-agent-report-check.mjs --file .octo-tmp/mac-browser-agent-verify.json --platform darwin --compare .octo-tmp/win-browser-agent-verify.json --compare-platform win32",
    "mac:browser-agent:report-check": "node scripts/browser-agent-report-check.mjs --file .octo-tmp/mac-browser-agent-verify.json --platform darwin --allow-skip-build",
    "win:browser-agent:report-check": "node scripts/browser-agent-report-check.mjs --file .octo-tmp/win-browser-agent-verify.json --platform win32",
    "mac:browser-agent:verify": "node scripts/browser-agent-verify.mjs --require-platform darwin --report .octo-tmp/mac-browser-agent-verify.json",
    "win:browser-agent:verify": "node scripts/browser-agent-verify.mjs --require-platform win32 --report .octo-tmp/win-browser-agent-verify.json",
    "win:browser-agent:verify:ps1": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/browser-agent-verify.ps1",
    "version:bump": "node scripts/bump-version.mjs",
    "skills:pack": "node scripts/skills-pack/build-skill-packs.mjs --config skills-pack/config.json",
    "skills:openjarvis:import": "node scripts/skills-pack/import-openjarvis-skills.mjs",
    "skills:openjarvis:import:public": "node scripts/skills-pack/import-openjarvis-skills.mjs --sync-public",
    "skills:web:fetch": "node scripts/skills-pack/fetch-web-skills-manifest.mjs",
    "code-search": "node scripts/octo-code-search.mjs",
    "code-graph": "node scripts/octo-code-graph.mjs",
    "editor-ctl": "node scripts/editor-control.mjs",
    "dev:screen": "node scripts/tauri-dev-screen.mjs",
    "dev:screen:start": "node scripts/tauri-dev-screen.mjs --start",
    "dev:screen:status": "node scripts/tauri-dev-screen.mjs status",
    "browser": "node agent-browser-cli/bin/bbarit-browser-control.mjs",
    "browser:smoke": "node agent-browser-cli/bin/bbarit-browser-control.mjs assert --url https://example.com --file .octo-tmp/browser-assert.json",
    "browser:open": "node agent-browser-cli/bin/bbarit-browser-control.mjs open",
    "browser:ai-audit": "node scripts/browser-ai-capability-audit.mjs --file .octo-tmp/browser-ai-capability-audit.json",
    "browser:platform-audit": "node scripts/browser-platform-audit.mjs --file .octo-tmp/browser-platform-audit.json",
    "browser:assert": "node agent-browser-cli/bin/bbarit-browser-control.mjs assert --file .octo-tmp/browser-assert.json",
    "browser:control-audit": "node agent-browser-cli/bin/bbarit-browser-control.mjs control-audit --url https://www.naver.com --session browser-control-audit --file .octo-tmp/browser-control-audit.json",
    "browser:verify": "npm run browser:ai-audit && npm run browser:platform-audit && npm run browser:assert && npm run browser:control-audit",
    "ui:audit": "node scripts/app-ui-audit.mjs",
    "ui:audit:routes": "node scripts/app-ui-audit.mjs --routes /,/browser,/harness,/skills-studio,/agent-terminal --screen-timeout-ms 60000 --route-settle-ms 900 --screenshots",
    "ui:audit:responsive": "node scripts/app-ui-audit.mjs --routes /,/browser,/harness,/skills-studio,/agent-terminal --viewports desktop:1440x980,tablet:900x1100,mobile:390x844 --screen-timeout-ms 60000 --resize-timeout-ms 12000 --route-settle-ms 1800 --screenshots --strict",
    "ui:audit:keyboard": "node scripts/app-ui-audit.mjs --routes /,/browser,/harness,/skills-studio,/agent-terminal --keyboard --keyboard-steps 16 --screen-timeout-ms 60000 --route-settle-ms 900 --strict",
    "ui:mojibake": "node scripts/check-ui-mojibake.mjs",
    "check:bundled-scripts": "node scripts/check-bundled-scripts.mjs",
    "app:bootstrap-smoke": "node scripts/app-bootstrap-smoke.mjs",
    "office:edit": "node scripts/office-edit.mjs",
    "office:api": "node scripts/office-edit.mjs api",
    "office:project": "node scripts/office-edit.mjs project:create",
    "office:cli-smoke": "node scripts/office-edit-cli-smoke.mjs",
    "ctl": "node scripts/bbarit-ctl.mjs",
    "test:source-build": "node --test tests/tauri-opensource.test.mjs tests/fork-release-manifest.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.14",
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@fontsource/nanum-gothic-coding": "^5.2.8",
    "@fontsource/source-code-pro": "^5.2.7",
    "@google/genai": "^1.44.0",
    "@langchain/core": "^1.1.40",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/langgraph-checkpoint": "^1.0.2",
    "@lezer/highlight": "^1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/core": "^3.23.2",
    "@tiptap/extension-code-block-lowlight": "^3.20.0",
    "@tiptap/extension-highlight": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extension-table-cell": "^3.20.0",
    "@tiptap/extension-table-header": "^3.20.0",
    "@tiptap/extension-table-row": "^3.20.0",
    "@tiptap/extension-task-item": "^3.20.0",
    "@tiptap/extension-task-list": "^3.20.0",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@uiw/react-codemirror": "^4.25.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "docx": "^9.6.0",
    "emmet-monaco-es": "^5.6.1",
    "highlight.js": "^11.11.1",
    "html2pdf.js": "^0.14.0",
    "jszip": "^3.10.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.1.1",
    "mermaid": "^12.2.0",
    "minisearch": "^7.2.0",
    "modern-screenshot": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "monaco-vim": "^0.4.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.8.1",
    "prosemirror-inputrules": "^1.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-filerobot-image-editor": "5.0.1",
    "react-konva": "19.2.4",
    "react-pdf": "^10.4.0",
    "sql.js": "^1.14.1",
    "styled-components": "6.4.1",
    "tiptap-markdown": "^0.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0",
    "xterm": "^5.3.0",
    "xterm-addon-webgl": "^0.16.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.2",
    "ws": "^8.21.0"
  },
  "overrides": {
    "argparse": "^2.0.1",
    "dompurify": "^3.4.17",
    "image-size": "^2.0.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johunsang/bbarit-terminal-opensource.git"
