{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BBARIT Terminal",
  "identifier": "com.octo.terminal",
  "version": "1.1.50",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3MzYzRTEzREIzQzhCMzUKUldRMWl6emJFejQycHlVS0lTUW1NWG5RNWJvVjFySUUwdUEyZ2h3alRSUWJ0OEllbmVMczV6dlYK"
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5175",
    "additionalWatchFolders": [
      "../bbarit-agent/src"
    ],
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BBARIT",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://asset.localhost ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: https:; style-src 'self' 'unsafe-inline' data: blob: https:; img-src * tauri: data: blob: asset: http://asset.localhost; media-src * tauri: data: blob: asset: http://asset.localhost; font-src * tauri: data: blob: asset: http://asset.localhost; connect-src * tauri: data: blob: ipc: http://ipc.localhost asset: http://asset.localhost; frame-src * tauri: data: blob: asset: http://asset.localhost; worker-src 'self' blob: data:; child-src 'self' blob: data:; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/claude-skills/**/*",
      "../agent-browser-cli/bin/bbarit-browser-control.mjs",
      "../bbarit-agent/personas/**/*",
      "../scripts/tauri-dev-screen.mjs"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
