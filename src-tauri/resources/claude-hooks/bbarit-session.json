{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$BBARIT_CLAUDE_HOOK\" ] || sh \"$BBARIT_CLAUDE_HOOK\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$BBARIT_CLAUDE_HOOK\" ] || sh \"${BBARIT_CLAUDE_HOOK%/*}/stop-failure.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 1,
            "command": "[ -z \"$BBARIT_CLAUDE_HOOK\" ] || { f=\"${BBARIT_CLAUDE_HOOK%/*}/user-prompt-submit.sh\"; [ ! -f \"$f\" ] || sh \"$f\"; }"
          }
        ]
      }
    ]
  }
}
